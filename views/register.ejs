<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register your account</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-slate-950 text-white min-h-screen flex items-center justify-center">
    <div class="w-full max-w-lg bg-white/5 border border-white/10 rounded-3xl p-8 shadow-2xl backdrop-blur-sm">
        <h1 class="text-3xl font-bold mb-2">Create account</h1>
        <p class="text-slate-300 mb-6">Join SurveyBuzz and start creating surveys.</p>

        <form action="/register" method="post" class="space-y-4">
            <input class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3 text-white focus:outline-none focus:ring-2 focus:ring-yellow-500" name="email" type="email" placeholder="Email" required>
            <input class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3 text-white focus:outline-none focus:ring-2 focus:ring-yellow-500" name="password" type="password" placeholder="Password" required>
            <button class="w-full bg-gradient-to-r from-yellow-400 to-orange-500 text-slate-900 font-bold py-3 rounded-xl hover:opacity-90 transition" type="submit">Register</button>
        </form>

        <p class="mt-6 text-center text-slate-300">
            Already have an account?
            <a class="text-blue-400 underline ml-1" href="/login">Login</a>
        </p>
    </div>
</body>
</html>