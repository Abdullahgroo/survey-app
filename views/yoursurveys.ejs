<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Surveys</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-zinc-900 text-white min-h-screen">
    <div class="max-w-6xl mx-auto p-8">
        <div class="flex items-center justify-between mb-8">
            <h1 class="text-3xl font-bold">Your Surveys</h1>
            <a href="/profile" class="text-blue-400 hover:text-blue-300">Back to profile</a>
        </div>

        <% if (!surveys || surveys.length === 0) { %>
            <div class="bg-zinc-800 rounded-lg p-6 border border-zinc-700">
                <p class="text-lg">You have not created any surveys yet.</p>
                <a href="/createyoursurvey" class="inline-block mt-4 text-yellow-400 underline">Create your first survey</a>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                <% surveys.forEach(function(survey){ %>
                    <div class="bg-zinc-800 rounded-xl p-5 border border-zinc-700 shadow-lg">
                        <p class="text-xs uppercase tracking-wide text-blue-300 mb-2"><%= survey.category %></p>
                        <h2 class="text-2xl font-semibold mb-3"><%= survey.title %></h2>
                        <p class="text-zinc-300 mb-4"><%= survey.description %></p>

                        <div class="text-sm text-zinc-400 space-y-2">
                            <p><strong>Target:</strong> <%= survey.target %></p>
                            <p><strong>Created:</strong> <%= new Date(survey.date).toLocaleDateString() %></p>
                            <p><strong>Responses:</strong> <%= survey.responses ? survey.responses.length : 0 %></p>
                        </div>
                        <a href="/survey/<%= survey._id %>/responses" class="inline-block mt-5 bg-blue-600 hover:bg-blue-500 text-white font-semibold px-4 py-2 rounded-lg transition">View responses</a>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</body>
</html>