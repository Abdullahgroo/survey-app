<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Dashboard</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-zinc-900 text-white min-h-screen">
    <div class="max-w-6xl mx-auto px-6 py-10">
        <div class="flex items-center justify-between mb-10">
            <div>
                <p class="text-sm uppercase tracking-[0.2em] text-blue-300">Dashboard</p>
                <h1 class="text-4xl font-bold mt-2">Welcome back</h1>
            </div>
            <a href="/logout" class="bg-red-600 hover:bg-red-500 text-white px-4 py-2 rounded-lg transition">Logout</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <a href="/yoursurveys" class="bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 rounded-2xl p-6 block transition">
                <div class="text-4xl mb-4">📊</div>
                <h2 class="text-2xl font-semibold mb-2">Your Surveys</h2>
                <p class="text-zinc-300">View every survey you created.</p>
            </a>

            <a href="/createyoursurvey" class="bg-gradient-to-br from-blue-600 to-cyan-500 hover:opacity-90 rounded-2xl p-6 block transition">
                <div class="text-4xl mb-4">➕</div>
                <h2 class="text-2xl font-semibold mb-2">Create Survey</h2>
                <p class="text-blue-100">Launch a new survey for your audience.</p>
            </a>

            <a href="/readsurvey" class="bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 rounded-2xl p-6 block transition">
                <div class="text-4xl mb-4">🌍</div>
                <h2 class="text-2xl font-semibold mb-2">Explore Surveys</h2>
                <p class="text-zinc-300">Browse surveys shared by others.</p>
            </a>
        </div>

        <div class="mt-10 bg-zinc-800 rounded-2xl border border-zinc-700 p-6">
            <h3 class="text-xl font-semibold mb-3">Quick actions</h3>
            <div class="flex flex-wrap gap-4">
                <a href="/createyoursurvey" class="bg-yellow-500 hover:bg-yellow-400 text-zinc-900 font-semibold px-4 py-2 rounded-lg">Create new survey</a>
                <a href="/yoursurveys" class="bg-blue-600 hover:bg-blue-500 px-4 py-2 rounded-lg">View your surveys</a>
            </div>
        </div>
    </div>
</body>
</html>