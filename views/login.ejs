<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-slate-950 text-white min-h-screen flex items-center justify-center">
    <% if (error) { %>
        <script>
            alert('<%= error %>');
        </script>
    <% } %>

    <div class="w-full max-w-md bg-white/5 border border-white/10 rounded-3xl p-8 shadow-2xl backdrop-blur-sm">
        <h1 class="text-3xl font-bold mb-2">Welcome back</h1>
        <p class="text-slate-300 mb-6">Sign in to your account</p>

        <form action="/login" method="post" class="space-y-4">
            <input class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3 text-white focus:outline-none focus:ring-2 focus:ring-pink-500" type="email" name="email" placeholder="Email" required>
            <input class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3 text-white focus:outline-none focus:ring-2 focus:ring-pink-500" type="password" name="password" placeholder="Password" required>
            <button class="w-full bg-gradient-to-r from-green-400 to-emerald-500 text-slate-900 font-bold py-3 rounded-xl hover:opacity-90 transition" type="submit">Login</button>
        </form>

        <div class="mt-6 text-center">
            <a class="text-blue-400 hover:text-blue-300 underline" href="/register">Create account</a>
        </div>
    </div>
</body>
</html>